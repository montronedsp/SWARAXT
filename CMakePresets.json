{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "win-release",
      "displayName": "Windows Release",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/win-release",
      "cacheVariables": {
        "SWARA_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "win-dev",
      "displayName": "Windows Development (tests ON)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/win-dev",
      "cacheVariables": {
        "SWARA_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SWARA_BUILD_TESTS": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-dev",
      "displayName": "Linux Development (tests ON)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SWARA_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "mac-release",
      "displayName": "macOS Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mac-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SWARA_BUILD_TESTS": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "mac-dev",
      "displayName": "macOS Development (tests ON)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mac-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SWARA_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-release",
      "configurePreset": "win-release",
      "configuration": "Release",
      "targets": ["SwaraXT_VST3", "SwaraXT_Standalone"]
    },
    {
      "name": "win-dev",
      "configurePreset": "win-dev",
      "configuration": "Debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "targets": ["SwaraXT_VST3", "SwaraXT_Standalone"]
    },
    {
      "name": "linux-dev",
      "configurePreset": "linux-dev"
    },
    {
      "name": "mac-release",
      "configurePreset": "mac-release",
      "targets": ["SwaraXT_VST3", "SwaraXT_Standalone"]
    },
    {
      "name": "mac-dev",
      "configurePreset": "mac-dev"
    }
  ]
}
