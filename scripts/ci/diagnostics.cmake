# Self-contained adapter for the existing opt-in Linux diagnostic targets.
set(DIAG_SANITIZER "OFF" CACHE STRING "Qualification sanitizer")
set(DIAG_FUZZER "OFF" CACHE STRING "Qualification fuzzer")
function(_diag_sanitizer_flags name compile_flags link_flags)
    if(name STREQUAL "asan-ubsan")
        set(flags -fsanitize=address,undefined,vptr -fno-sanitize-recover=all -fno-omit-frame-pointer)
    elseif(name STREQUAL "tsan")
        set(flags -fsanitize=thread -fno-omit-frame-pointer)
    elseif(name STREQUAL "rtsan")
        set(flags -fsanitize=realtime -fno-omit-frame-pointer)
    elseif(name STREQUAL "OFF")
        set(flags "")
    else()
        message(FATAL_ERROR "Unsupported sanitizer ${name}")
    endif()
    set(${compile_flags} ${flags} PARENT_SCOPE)
    set(${link_flags} ${flags} PARENT_SCOPE)
endfunction()
function(diag_apply target)
    _diag_sanitizer_flags("${DIAG_SANITIZER}" compile_flags link_flags)
    target_compile_options(${target} PRIVATE ${compile_flags})
    target_link_options(${target} PRIVATE ${link_flags})
endfunction()
function(diag_fuzz_target target)
    target_compile_options(${target} PRIVATE -fsanitize=fuzzer-no-link)
    target_link_options(${target} PRIVATE -fsanitize=fuzzer)
endfunction()
