root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{h,hpp,c,cc,cpp,cxx,mm}]
indent_size = 4
max_line_length = 100

[*.{md,yml,yaml}]
indent_size = 2
trim_trailing_whitespace = false

[*.{cmake,CMakeLists.txt}]
indent_size = 4

[*.json]
indent_size = 2

[Makefile]
indent_style = tab
