file(READ "${ROM_SOURCE}" rom)
string(REGEX MATCH "lut_res_oscillator_increments\\[\\][^=]*=[ \r\n]*\\{[^}]*\\}" definition "${rom}")
if(NOT definition)
    message(FATAL_ERROR "Oscillator increment ROM definition missing")
endif()
string(REGEX MATCHALL "[0-9]+" entries "${definition}")
list(LENGTH entries count)
if(NOT count EQUAL 97)
    message(FATAL_ERROR "Oscillator interpolation requires the qualified 97-element ROM; found ${count}")
endif()
message(STATUS "Authoritative oscillator increment ROM extent: ${count}")
