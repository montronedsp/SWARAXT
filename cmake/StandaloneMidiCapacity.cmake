# Linux/Windows host storage contract. The caller's JUCE checkout is unchanged.
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT CMAKE_SYSTEM_NAME STREQUAL "Windows")
    return()
endif()

function(swaraxt_prepare_midi_capacity)
    set(contract_header "${CMAKE_SOURCE_DIR}/Source/Engine/MidiOutputCapacity.h")
    file(STRINGS "${contract_header}" reserve_line REGEX "kMidiOutputReserveBytes = [0-9]+;")
    if(NOT reserve_line)
        message(FATAL_ERROR "MIDI output storage contract is missing")
    endif()
    string(REGEX MATCH "kMidiOutputReserveBytes = ([0-9]+)" reserve_match "${reserve_line}")
    set(reserve_bytes "${CMAKE_MATCH_1}")
    if(NOT reserve_bytes MATCHES "^[0-9]+$")
        message(FATAL_ERROR "MIDI output storage contract is not numeric")
    endif()
    set(module_dir "${SWARAXT_JUCE_DIR}/modules/juce_audio_utils")
    set(player_source "${module_dir}/players/juce_AudioProcessorPlayer.cpp")
    set(module_source "${module_dir}/juce_audio_utils.cpp")
    set(vst3_source "${SWARAXT_JUCE_DIR}/modules/juce_audio_plugin_client/juce_audio_plugin_client_VST3.cpp")
    file(STRINGS "${vst3_source}" vst3_reserve REGEX "midiBuffer.ensureSize \\([0-9]+\\)")
    if(NOT vst3_reserve)
        message(FATAL_ERROR "Supported JUCE VST3 MIDI reserve was not found")
    endif()
    string(REGEX REPLACE ".*ensureSize \\(([0-9]+)\\).*" "\\1" vst3_bytes "${vst3_reserve}")
    if(vst3_bytes LESS reserve_bytes)
        message(FATAL_ERROR "JUCE VST3 MIDI reserve is below the processor contract")
    endif()

    # Modify only the common player constructor in a build-local source overlay.
    # Exact anchors fail closed when the supported JUCE implementation changes.
    file(READ "${player_source}" player)
    string(REPLACE "\r\n" "\n" player "${player}")
    set(anchor "AudioProcessorPlayer::AudioProcessorPlayer (bool doDoublePrecisionProcessing)\n    : isDoublePrecision (doDoublePrecisionProcessing)\n{\n}")
    string(FIND "${player}" "${anchor}" anchor_position)
    if(anchor_position LESS 0)
        message(FATAL_ERROR "Supported JUCE player constructor was not found")
    endif()
    set(replacement "AudioProcessorPlayer::AudioProcessorPlayer (bool doDoublePrecisionProcessing)\n    : isDoublePrecision (doDoublePrecisionProcessing)\n{\n    incomingMidi.ensureSize (${reserve_bytes});\n}")
    string(REPLACE "${anchor}" "${replacement}" player "${player}")

    set(overlay_dir "${CMAKE_BINARY_DIR}/generated/midi-capacity")
    file(MAKE_DIRECTORY "${overlay_dir}")
    set(overlay_player "${overlay_dir}/juce_AudioProcessorPlayer.cpp")
    set(overlay_module "${overlay_dir}/juce_audio_utils.cpp")
    function(swaraxt_write_midi_overlay path contents)
        if(EXISTS "${path}")
            file(READ "${path}" previous)
            if(previous STREQUAL contents)
                return()
            endif()
        endif()
        file(WRITE "${path}" "${contents}")
    endfunction()
    swaraxt_write_midi_overlay("${overlay_player}" "${player}")

    file(READ "${module_source}" module)
    # Preserve the module implementation and resolve its quoted includes from the
    # original module directory; redirect only the player implementation include.
    string(REGEX REPLACE "(#[ \t]*include[ \t]+\")([^\"]+)(\")"
        "\\1${module_dir}/\\2\\3" module "${module}")
    set(player_include "#include \"${player_source}\"")
    string(FIND "${module}" "${player_include}" include_position)
    if(include_position LESS 0)
        message(FATAL_ERROR "Supported JUCE player module include was not found")
    endif()
    string(REPLACE "${player_include}" "#include \"${overlay_player}\"" module "${module}")
    swaraxt_write_midi_overlay("${overlay_module}" "${module}")

    get_target_property(module_sources juce_audio_utils INTERFACE_SOURCES)
    set(replaced FALSE)
    set(overlay_sources "")
    foreach(source IN LISTS module_sources)
        string(FIND "${source}" "${module_source}" source_position)
        if(NOT source_position LESS 0)
            string(REPLACE "${module_source}" "${overlay_module}" source "${source}")
            set(replaced TRUE)
        endif()
        list(APPEND overlay_sources "${source}")
    endforeach()
    if(NOT replaced)
        message(FATAL_ERROR "Supported JUCE audio-utils module target source was not found")
    endif()
    set_property(TARGET juce_audio_utils PROPERTY INTERFACE_SOURCES "${overlay_sources}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${contract_header}" "${player_source}" "${module_source}" "${vst3_source}")

endfunction()
swaraxt_prepare_midi_capacity()
