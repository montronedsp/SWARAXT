if(NOT CONVERTER OR NOT SOURCE_DIR OR NOT OUTPUT)
    message(FATAL_ERROR "EmbedBuiltinTunings requires CONVERTER, SOURCE_DIR and OUTPUT")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/BuiltinTunings.cmake")
set(header "// Generated by SwaraXtTuningConverter. Do not edit.\n#pragma once\n#include <cstddef>\n#include <cstdint>\n\nnamespace swaraxt::tuning {\n")
set(entries "")
foreach(entry IN LISTS SWARAXT_BUILTIN_TUNINGS)
    string(REPLACE "|" ";" fields "${entry}")
    list(GET fields 0 name)
    list(GET fields 1 ident)
    list(GET fields 2 display_name)
    string(APPEND entries "    { \"${display_name}\", ${ident}, ${ident}Size },\n")
    get_filename_component(out_dir "${OUTPUT}" DIRECTORY)
    file(MAKE_DIRECTORY "${out_dir}")
    set(scl "${SOURCE_DIR}/${name}.scl")
    set(swt "${out_dir}/${name}.swt")
    execute_process(
        COMMAND "${CONVERTER}" "${scl}" "${swt}"
        RESULT_VARIABLE convert_result
        OUTPUT_VARIABLE convert_out
        ERROR_VARIABLE convert_err)
    if(NOT convert_result EQUAL 0)
        message(FATAL_ERROR "tuning conversion failed for ${name}: ${convert_err}")
    endif()
    file(READ "${swt}" bytes HEX)
    string(LENGTH "${bytes}" hex_length)
    math(EXPR byte_count "${hex_length} / 2")
    string(APPEND header "inline constexpr uint8_t ${ident}[] = {\n")
    set(byte_index 0)
    while(byte_index LESS byte_count)
        math(EXPR hex_index "${byte_index} * 2")
        string(SUBSTRING "${bytes}" ${hex_index} 2 pair)
        string(APPEND header "0x${pair},")
        math(EXPR byte_index "${byte_index} + 1")
        math(EXPR mod "${byte_index} % 16")
        if(mod EQUAL 0)
            string(APPEND header "\n")
        endif()
    endwhile()
    string(APPEND header "\n};\ninline constexpr size_t ${ident}Size = sizeof(${ident});\n\n")
endforeach()
string(APPEND header "struct BuiltinTuningEntry { const char* name; const uint8_t* data; size_t size; };\ninline constexpr BuiltinTuningEntry kBuiltinTunings[] = {\n${entries}};\n}  // namespace swaraxt::tuning\n")
file(WRITE "${OUTPUT}" "${header}")
