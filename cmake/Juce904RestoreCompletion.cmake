# Build-owned exception boundary for the exact Linux JUCE 9.0.4 pin.
function(swaraxt_verify_restore_completion source generated)
    set(module "juce_audio_processors")
    file(GLOB_RECURSE original_files LIST_DIRECTORIES FALSE RELATIVE "${source}/${module}" "${source}/${module}/*")
    file(GLOB_RECURSE generated_files LIST_DIRECTORIES FALSE RELATIVE "${generated}/${module}" "${generated}/${module}/*")
    if(NOT original_files STREQUAL generated_files)
        message(FATAL_ERROR "JUCE restore-completion module inventory drift")
    endif()
    foreach(path IN LISTS original_files)
        file(SHA256 "${source}/${module}/${path}" original_hash)
        if(path STREQUAL "utilities/juce_AudioProcessorValueTreeState.cpp")
            if(NOT original_hash STREQUAL "94760f6858acf7fcf52915504cc24702cdea9c031d9a9593919de108884a1ad6")
                message(FATAL_ERROR "JUCE restore-completion input implementation drift")
            endif()
            set(expected "ba3547692fa4aeeb922d73c0656d60db066b20eb25ebb3e58c101f8788ba88a7")
        elseif(path STREQUAL "utilities/juce_AudioProcessorValueTreeState.h")
            if(NOT original_hash STREQUAL "39bc0e4fdb9cff4feb34cf0d3013ec4242ca8e6524a40b508509db03afb9a1e0")
                message(FATAL_ERROR "JUCE restore-completion input header drift")
            endif()
            set(expected "27fedfd07bcc16df768c2b501d3965e454e47c9f5141c9275edc7d8fed434d3a")
        else()
            set(expected "${original_hash}")
        endif()
        file(SHA256 "${generated}/${module}/${path}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "JUCE restore-completion output drift: ${path}")
        endif()
    endforeach()
endfunction()

if(DEFINED SWARAXT_VERIFY_RESTORE_SOURCE)
    swaraxt_verify_restore_completion("${SWARAXT_VERIFY_RESTORE_SOURCE}" "${SWARAXT_VERIFY_RESTORE_MODULES}")
    return()
endif()

find_package(Git REQUIRED)
set(restore_patch "${CMAKE_CURRENT_LIST_DIR}/Juce904RestoreCompletion.patch")
set(restore_root "${CMAKE_BINARY_DIR}/generated/restore-completion")
set(restore_modules "${restore_root}/modules")
set(restore_manifest "${restore_root}/manifest.txt")
file(SHA256 "${restore_patch}" restore_patch_hash)
set(previous_patch "")
if(EXISTS "${restore_manifest}")
    file(READ "${restore_manifest}" previous_patch)
endif()
if(NOT previous_patch STREQUAL restore_patch_hash)
    file(MAKE_DIRECTORY "${restore_modules}")
    file(COPY "${SWARAXT_JUCE_DIR}/modules/juce_audio_processors" DESTINATION "${restore_modules}")
    foreach(extension cpp h)
        set(relative "juce_audio_processors/utilities/juce_AudioProcessorValueTreeState.${extension}")
        file(READ "${SWARAXT_JUCE_DIR}/modules/${relative}" text)
        file(WRITE "${restore_modules}/${relative}" "${text}")
    endforeach()
    execute_process(COMMAND "${GIT_EXECUTABLE}" apply --check "${restore_patch}"
        WORKING_DIRECTORY "${restore_root}" RESULT_VARIABLE checked ERROR_VARIABLE error)
    if(NOT checked EQUAL 0)
        message(FATAL_ERROR "JUCE restore-completion patch check failed: ${error}")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" apply "${restore_patch}"
        WORKING_DIRECTORY "${restore_root}" RESULT_VARIABLE applied ERROR_VARIABLE error)
    if(NOT applied EQUAL 0)
        message(FATAL_ERROR "JUCE restore-completion patch failed: ${error}")
    endif()
    file(WRITE "${restore_manifest}" "${restore_patch_hash}")
endif()
swaraxt_verify_restore_completion("${SWARAXT_JUCE_DIR}/modules" "${restore_modules}")
include_directories(BEFORE "${restore_modules}")
target_include_directories(juce_audio_processors BEFORE INTERFACE "${restore_modules}")
get_target_property(restore_sources juce_audio_processors INTERFACE_SOURCES)
string(REPLACE "${SWARAXT_JUCE_DIR}/modules/juce_audio_processors/juce_audio_processors.cpp"
    "${restore_modules}/juce_audio_processors/juce_audio_processors.cpp" restore_sources "${restore_sources}")
set_property(TARGET juce_audio_processors PROPERTY INTERFACE_SOURCES "${restore_sources}")
add_compile_definitions(SWARAXT_JUCE_RESTORE_COMPLETION=1)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${restore_patch}")
add_custom_target(SwaraXTVerifyRestoreCompletion
    COMMAND "${CMAKE_COMMAND}" "-DSWARAXT_VERIFY_RESTORE_SOURCE=${SWARAXT_JUCE_DIR}/modules"
        "-DSWARAXT_VERIFY_RESTORE_MODULES=${restore_modules}"
        -P "${CMAKE_CURRENT_LIST_FILE}" VERBATIM)
add_dependencies(juce_audio_processors SwaraXTVerifyRestoreCompletion)
