# Linux-only, exact-source dependency contract. Never edits the input checkout.
function(swaraxt_verify_linux_juce904 source)
    find_package(Git REQUIRED)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" rev-parse HEAD
        RESULT_VARIABLE result OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT result EQUAL 0 OR NOT revision STREQUAL "3fb5cbc0340758596dac39f7c8de47d562b4896e")
        message(FATAL_ERROR "Linux requires exact JUCE 9.0.4 revision 3fb5cbc0340758596dac39f7c8de47d562b4896e")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" status --porcelain --untracked-files=all --ignored
        RESULT_VARIABLE result OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT result EQUAL 0 OR NOT dirty STREQUAL "")
        message(FATAL_ERROR "JUCE 9.0.4 dependency drift: tracked, untracked or ignored changes")
    endif()
    file(SHA256 "${source}/CMakeLists.txt" actual)
    if(NOT actual STREQUAL "aae85275cc7f08b89dac8a6c0d075d5475ff114a327ece1b77fcf60da1bad738")
        message(FATAL_ERROR "JUCE hash mismatch: CMakeLists.txt")
    endif()
    file(SHA256 "${source}/modules/juce_events/native/juce_Messaging_linux.cpp" actual)
    if(NOT actual STREQUAL "b3adb1f787c9af61fff19a31a1457a47b274efcd8e58f3773b559093e34e5f5b")
        message(FATAL_ERROR "JUCE hash mismatch: modules/juce_events/native/juce_Messaging_linux.cpp")
    endif()
    file(SHA256 "${source}/modules/juce_events/messages/juce_MessageManager.cpp" actual)
    if(NOT actual STREQUAL "dd644cf2f2a3bac0b7f7737cdabac2ad9307e7a33ca2fc748d8c2876c39f97fa")
        message(FATAL_ERROR "JUCE hash mismatch: modules/juce_events/messages/juce_MessageManager.cpp")
    endif()
    file(SHA256 "${source}/modules/juce_audio_basics/buffers/juce_AudioChannelSet.h" actual)
    if(NOT actual STREQUAL "445a53855d3fabc8304db1fdd465b43718924644864a9f429ca4839f00eb930a")
        message(FATAL_ERROR "JUCE hash mismatch: modules/juce_audio_basics/buffers/juce_AudioChannelSet.h")
    endif()
    file(SHA256 "${source}/modules/juce_audio_utils/players/juce_AudioProcessorPlayer.cpp" actual)
    if(NOT actual STREQUAL "f4c99635ed179993bc3316e3e568ccc0447c89163f39e2caa51952ae68181f1e")
        message(FATAL_ERROR "JUCE hash mismatch: modules/juce_audio_utils/players/juce_AudioProcessorPlayer.cpp")
    endif()
    file(SHA256 "${source}/modules/juce_audio_utils/juce_audio_utils.cpp" actual)
    if(NOT actual STREQUAL "52edf748d788e7162e92002fefa13c45eda998650955534ca0db0fa9d1eaa78d")
        message(FATAL_ERROR "JUCE hash mismatch: modules/juce_audio_utils/juce_audio_utils.cpp")
    endif()
    file(SHA256 "${source}/modules/juce_audio_basics/buffers/juce_AudioChannelSet.cpp" actual)
    if(NOT actual STREQUAL "6384bdcfdc26f369c85e30dbdb869ad249e054bd90ea75b234e8f4729af25d34")
        message(FATAL_ERROR "JUCE AudioChannelSet implementation identity mismatch")
    endif()
endfunction()

if(DEFINED SWARAXT_VERIFY_JUCE904_SOURCE)
    swaraxt_verify_linux_juce904("${SWARAXT_VERIFY_JUCE904_SOURCE}")
    if(DEFINED SWARAXT_VERIFY_CHANNEL_CPP)
        file(SHA256 "${SWARAXT_VERIFY_CHANNEL_CPP}" effective_cpp_hash)
        if(NOT effective_cpp_hash STREQUAL "5e08cda3ba54106b5a59912df85f5942d019bdfd1e531069c08debba75fe251d")
            message(FATAL_ERROR "Generated ChannelType WAVE-sentinel implementation drift")
        endif()
    endif()
    if(DEFINED SWARAXT_VERIFY_CHANNEL_CPP)
        get_filename_component(swaraxt_generated_buffers "${SWARAXT_VERIFY_CHANNEL_CPP}" DIRECTORY)
        get_filename_component(swaraxt_generated_module "${swaraxt_generated_buffers}/.." ABSOLUTE)
        set(swaraxt_base_module "${SWARAXT_VERIFY_JUCE904_SOURCE}/modules/juce_audio_basics")
        file(GLOB_RECURSE swaraxt_base_files LIST_DIRECTORIES FALSE RELATIVE "${swaraxt_base_module}" "${swaraxt_base_module}/*")
        file(GLOB_RECURSE swaraxt_generated_files LIST_DIRECTORIES FALSE RELATIVE "${swaraxt_generated_module}" "${swaraxt_generated_module}/*")
        if(NOT swaraxt_base_files STREQUAL swaraxt_generated_files)
            message(FATAL_ERROR "Generated audio-basics file inventory drift")
        endif()
        foreach(swaraxt_file IN LISTS swaraxt_base_files)
            if(swaraxt_file STREQUAL "buffers/juce_AudioChannelSet.h")
                set(swaraxt_expected "5f1308b04dbaf4646ac420001068b2b90f41c0977a61fce5931ac6988ffa7675")
            elseif(swaraxt_file STREQUAL "buffers/juce_AudioChannelSet.cpp")
                set(swaraxt_expected "5e08cda3ba54106b5a59912df85f5942d019bdfd1e531069c08debba75fe251d")
            else()
                file(SHA256 "${swaraxt_base_module}/${swaraxt_file}" swaraxt_expected)
            endif()
            file(SHA256 "${swaraxt_generated_module}/${swaraxt_file}" swaraxt_actual)
            if(NOT swaraxt_actual STREQUAL swaraxt_expected)
                message(FATAL_ERROR "Generated audio-basics source drift: ${swaraxt_file}")
            endif()
        endforeach()
    endif()
    if(DEFINED SWARAXT_VERIFY_CHANNEL_HEADER)
        file(SHA256 "${SWARAXT_VERIFY_CHANNEL_HEADER}" effective_hash)
        if(NOT effective_hash STREQUAL "5f1308b04dbaf4646ac420001068b2b90f41c0977a61fce5931ac6988ffa7675")
            message(FATAL_ERROR "Generated ChannelType compatibility source drift")
        endif()
    endif()
endif()
