# Linux/Windows test qualification only; shipping targets are unchanged.
include_guard(GLOBAL)
if(NOT CMAKE_CONFIGURATION_TYPES AND NOT CMAKE_BUILD_TYPE MATCHES "^(Debug|Release|RelWithDebInfo|MinSizeRel)$")
    message(FATAL_ERROR "Qualification requires an explicit CMAKE_BUILD_TYPE (Debug, Release, RelWithDebInfo or MinSizeRel)")
endif()
if(NOT CMAKE_CONFIGURATION_TYPES AND CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang)$")
    string(TOUPPER "${CMAKE_BUILD_TYPE}" configuration)
    set(effective_flags "${CMAKE_CXX_FLAGS} ${CMAKE_CXX_FLAGS_${configuration}}")
    if(CMAKE_BUILD_TYPE MATCHES "^(Release|RelWithDebInfo|MinSizeRel)$")
        string(REGEX MATCHALL "(^|[ ])-O[0-9sgzfast]+" optimization_flags "${effective_flags}")
        if(NOT optimization_flags)
            message(FATAL_ERROR "Optimized qualification has no optimization flag: ${effective_flags}")
        endif()
        list(GET optimization_flags -1 optimization)
        if(optimization MATCHES "-O0$")
            message(FATAL_ERROR "Optimized qualification ends with -O0")
        endif()
    endif()
endif()
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
option(SWARAXT_SHARE_TEST_JUCE "Share compatible Linux test JUCE module compilation" OFF)
option(SWARAXT_SHARE_TEST_PRODUCTION "Share identically configured Linux test production objects" OFF)
set(SWARAXT_DIAGNOSTICS_MODULE "" CACHE FILEPATH "Optional external Diagnostics.cmake for Linux test targets")
if((DIAG_WARNINGS OR DIAG_WARNINGS_AS_ERRORS OR DIAG_CLANG_TIDY OR DIAG_GCC_ANALYZER OR DIAG_COVERAGE OR (DEFINED DIAG_SANITIZER AND NOT DIAG_SANITIZER STREQUAL "OFF") OR (DEFINED DIAG_FUZZER AND NOT DIAG_FUZZER STREQUAL "OFF")) AND NOT SWARAXT_DIAGNOSTICS_MODULE)
    message(FATAL_ERROR "Set SWARAXT_DIAGNOSTICS_MODULE to enable diagnostic instrumentation")
endif()
if(SWARAXT_DIAGNOSTICS_MODULE)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
        message(FATAL_ERROR "The external diagnostic adapter is Linux-only; Windows uses its MSVC diagnostic targets")
    endif()
    if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
        message(FATAL_ERROR "Linux qualification requires GCC or Clang")
    endif()
    include("${SWARAXT_DIAGNOSTICS_MODULE}")
    if((DIAG_SANITIZER STREQUAL "tsan" OR DIAG_SANITIZER STREQUAL "rtsan") AND NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
        message(FATAL_ERROR "This qualification requires upstream Clang for TSan/RTSan")
    endif()
    if(NOT DIAG_SANITIZER MATCHES "^(OFF|asan-ubsan|tsan|rtsan)$")
        message(FATAL_ERROR "Unsupported qualification sanitizer")
    endif()
    include(CheckCXXCompilerFlag)
    if(NOT DIAG_SANITIZER STREQUAL "OFF")
        include(CMakePushCheckState)
        cmake_push_check_state(RESET)
        _diag_sanitizer_flags("${DIAG_SANITIZER}" compile_flags link_flags)
        set(CMAKE_REQUIRED_LINK_OPTIONS ${link_flags})
        string(JOIN " " probe_flags ${compile_flags})
        string(MAKE_C_IDENTIFIER "SWARAXT_${DIAG_SANITIZER}_${CMAKE_CXX_COMPILER_ID}_${CMAKE_CXX_COMPILER_VERSION}_SUPPORTED" probe_result)
        check_cxx_compiler_flag("${probe_flags}" ${probe_result})
        cmake_pop_check_state()
        if(NOT ${probe_result})
            message(FATAL_ERROR "Requested sanitizer cannot compile and link")
        endif()
    endif()
endif()

function(swaraxt_label_tests)
    get_property(tests DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" PROPERTY TESTS)
    foreach(test IN LISTS tests)
        get_property(timeout TEST ${test} PROPERTY TIMEOUT)
        if(NOT timeout)
            set_tests_properties(${test} PROPERTIES TIMEOUT 300)
        endif()
        get_property(labels TEST ${test} PROPERTY LABELS)
        if(NOT "extended" IN_LIST labels AND NOT "sanitizer" IN_LIST labels)
            set_property(TEST ${test} APPEND PROPERTY LABELS quick)
        endif()
    endforeach()
endfunction()

# Keep the known unsigned-negative comparison diagnostic visible during GCC
# qualification. Its production correction requires separate review; this
# narrow exception does not suppress the warning or affect shipping builds.
if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND TARGET SwaraXtTuningConverter)
    target_compile_options(SwaraXtTuningConverter PRIVATE -Wno-error=type-limits)
endif()
