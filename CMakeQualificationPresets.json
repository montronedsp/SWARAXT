{
  "version": 6,
  "configurePresets": [
    {
      "name": "qual-linux-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../swaraxt-builds/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "SWARA_BUILD_TESTS": "ON",
        "SWARA_BUILD_SKIN_EDITOR": "OFF",
        "SWARAXT_SHARE_TEST_JUCE": "ON",
        "SWARAXT_SHARE_TEST_PRODUCTION": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "qual-linux-gcc-release",
      "inherits": "qual-linux-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "qual-linux-gcc-debug",
      "inherits": "qual-linux-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "qual-linux-clang-release",
      "inherits": "qual-linux-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "qual-linux-clang-debug",
      "inherits": "qual-linux-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "qual-linux-gcc-asan-ubsan",
      "inherits": "qual-linux-gcc-debug",
      "cacheVariables": {
        "SWARAXT_DIAGNOSTICS_MODULE": "$env{SWARAXT_DIAGNOSTICS_MODULE}",
        "DIAG_SANITIZER": "asan-ubsan"
      }
    },
    {
      "name": "qual-linux-clang-asan-ubsan",
      "inherits": "qual-linux-clang-debug",
      "cacheVariables": {
        "SWARAXT_DIAGNOSTICS_MODULE": "$env{SWARAXT_DIAGNOSTICS_MODULE}",
        "DIAG_SANITIZER": "asan-ubsan"
      }
    },
    {
      "name": "qual-linux-clang-tsan",
      "inherits": "qual-linux-clang-debug",
      "cacheVariables": {
        "SWARAXT_DIAGNOSTICS_MODULE": "$env{SWARAXT_DIAGNOSTICS_MODULE}",
        "DIAG_SANITIZER": "tsan"
      }
    },
    {
      "name": "qual-linux-clang-rtsan",
      "inherits": "qual-linux-clang-debug",
      "cacheVariables": {
        "SWARAXT_DIAGNOSTICS_MODULE": "$env{SWARAXT_DIAGNOSTICS_MODULE}",
        "DIAG_SANITIZER": "rtsan"
      }
    },
    {
      "name": "qual-linux-gcc-warnings",
      "inherits": "qual-linux-gcc-release",
      "cacheVariables": {
        "SWARAXT_DIAGNOSTICS_MODULE": "$env{SWARAXT_DIAGNOSTICS_MODULE}",
        "DIAG_WARNINGS": "ON"
      }
    },
    {
      "name": "qual-linux-clang-warnings",
      "inherits": "qual-linux-clang-release",
      "cacheVariables": {
        "SWARAXT_DIAGNOSTICS_MODULE": "$env{SWARAXT_DIAGNOSTICS_MODULE}",
        "DIAG_WARNINGS": "ON"
      }
    },
    {
      "name": "qual-linux-gcc-analyzer",
      "inherits": "qual-linux-gcc-debug",
      "cacheVariables": {
        "SWARAXT_DIAGNOSTICS_MODULE": "$env{SWARAXT_DIAGNOSTICS_MODULE}",
        "DIAG_GCC_ANALYZER": "ON"
      }
    },
    {
      "name": "qual-linux-clang-tidy",
      "inherits": "qual-linux-clang-debug",
      "cacheVariables": {
        "SWARAXT_DIAGNOSTICS_MODULE": "$env{SWARAXT_DIAGNOSTICS_MODULE}",
        "DIAG_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "qual-linux-coverage",
      "inherits": "qual-linux-clang-debug",
      "cacheVariables": {
        "SWARAXT_DIAGNOSTICS_MODULE": "$env{SWARAXT_DIAGNOSTICS_MODULE}",
        "DIAG_COVERAGE": "ON"
      }
    },
    {
      "name": "qual-linux-libfuzzer",
      "inherits": "qual-linux-clang-debug",
      "cacheVariables": {
        "SWARAXT_DIAGNOSTICS_MODULE": "$env{SWARAXT_DIAGNOSTICS_MODULE}",
        "DIAG_FUZZER": "libfuzzer",
        "DIAG_SANITIZER": "asan-ubsan"
      }
    },
    {
      "name": "qual-windows",
      "binaryDir": "${sourceDir}/../swaraxt-builds/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "SWARA_BUILD_TESTS": "ON",
        "SWARA_BUILD_SKIN_EDITOR": "OFF"
      }
    }
  ],
